{
  "expo": {
    "name": "Floorline",
    "slug": "floorline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jenzylove.floorline",
      "associatedDomains": [
        "webcredentials:floorline-app.vercel.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121410",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jenzylove.floorline",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#121410",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121410"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b214e7d7-9601-4c34-a00d-bdc0e7ad32dc"
      }
    },
    "owner": "jdollars-team",
    "updates": {
      "url": "https://u.expo.dev/b214e7d7-9601-4c34-a00d-bdc0e7ad32dc"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
