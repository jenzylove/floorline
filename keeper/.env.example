# Perpl hedge bot. Read-only until TRADING_ENABLED=1 plus a keeper key (EXECUTION=vault) or an API key (EXECUTION=api).
PERPL_CHAIN_ID=143
RPC_URL=https://rpc.monad.xyz
PERPL_API_URL=https://app.perpl.xyz/api
PERPL_WS_URL=wss://app.perpl.xyz
VAULT_ADDRESS=0x85c57FEc4c4861B7D3a99D47C5189de62221a748
HEDGE_MARKETS=10
PERPL_API_KEY=
PERPL_API_KEY_SECRET=
TRADING_ENABLED=0
# vault (default): orders go through HedgedFloorVault.hedge from the vault's own Perpl account; the keeper key also posts vol and settles.
# api: orders go through Perpl's trading API from the API key's account.
EXECUTION=vault
KEEPER_PRIVATE_KEY=
# VOL_EVERY_MS=600000
# Optional risk limits (AUSD). Defaults: max short 9, max single order 10, no new shorts below 5 equity.
# MAX_POSITION_NOTIONAL=9
# MIN_EQUITY=5
